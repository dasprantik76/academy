{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/login.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/a",
      "destination": "https://diganta.pixelsetu.com",
      "permanent": true
    },
    {
      "source": "/a/:match*",
      "destination": "https://diganta.pixelsetu.com",
      "permanent": true
    },
    {
      "source": "/academy/:match*",
      "destination": "https://diganta.pixelsetu.com",
      "permanent": true
    }
  ]
}
